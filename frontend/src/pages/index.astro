---
import { type SanityDocument } from "@sanity/client";

import ContentContainer from "../components/ContentContainer";
import Footer from "../components/Footer";
import Header from "../components/Header";
import Navigation from "../components/Navigation";
import Projects from "../components/Projects";
import WorkComponent from "../components/Work";
import { sections } from "../constants";
import Layout from "../layouts/Layout.astro";
import {
  buildImageUrl,
  client,
  HEADER_QUERY,
  PERSONAL_PROJECT_QUERY,
  PROFESSIONAL_PROJECT_QUERY,
  WORK_QUERY,
} from "../lib/sanity";
import "../styles.css";
import type { Header as HeaderType, Project, Work } from "../types/project";

const work = await client.fetch<SanityDocument<Work[]>>(WORK_QUERY);

const headerContent =
  await client.fetch<SanityDocument<HeaderType[]>>(HEADER_QUERY);

const workMap = work.sort((a, b) => a.order - b.order);

const personalProjects = await client.fetch<SanityDocument<Project[]>>(
  PERSONAL_PROJECT_QUERY,
);
const professionalProjects = await client.fetch<SanityDocument<Project[]>>(
  PROFESSIONAL_PROJECT_QUERY,
);

const personalProjectMap = personalProjects.map((project) => {
  return {
    ...project,
    optImage: buildImageUrl(project.mainImage),
  };
});

const professionalProjectMap = professionalProjects.map((project) => {
  return {
    ...project,
    optImage: buildImageUrl(project.mainImage),
  };
});
---

<Layout>
  <Navigation client:only="react" currentPath="home" />
  <main id={sections[0].name}>
    <Header header={headerContent?.[0]} />
    <ContentContainer id={sections[1].name}>
      <Projects
        personalProjects={personalProjectMap}
        professionalProjects={professionalProjectMap}
      />
    </ContentContainer>
    <ContentContainer id={sections[2].name}>
      <WorkComponent workMap={workMap} />
    </ContentContainer>
    <ContentContainer id="footer" isLast>
      <Footer />
    </ContentContainer>
  </main>
</Layout>
